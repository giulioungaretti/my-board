{
  "name": "my-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/index.ts",
    "build": "npm run typecheck && vite build && vite build --config vite.extension.config.ts && node scripts/package-extension.mjs && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node dist-server/server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "safari:project": "node scripts/safari-project.mjs"
  },
  "dependencies": {
    "@giulioungaretti/home-design-system": "git+https://github.com/giulioungaretti/home-design-system.git#0316ab7fb7b80f6c83714ddff22ec0c54b4cd87f",
    "express": "^5.3.0",
    "ipaddr.js": "^2.2.0",
    "linkedom": "^0.18.12",
    "lucide-react": "^0.577.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "webextension-polyfill": "^0.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.3",
    "@types/webextension-polyfill": "^0.12.4",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.0.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.0"
  }
}
